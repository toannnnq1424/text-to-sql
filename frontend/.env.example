# Public build configuration only. Never put secrets in VITE_*.
VITE_API_BASE_URL=/api/v1
# Vite development proxy; production routes /api to Java via reverse proxy.
API_PROXY_TARGET=http://127.0.0.1:8080
# Real OIDC provider (authorization code + PKCE). Public client; no client secret.
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SCOPE=openid profile email
# If provider uses custom roles claim, set its claim name.
VITE_OIDC_ROLE_CLAIM=roles
# Explicit local packaged-build allowance; HTTP authority AND app must be loopback.
# Leave false for remote/production deployments, which require HTTPS.
VITE_OIDC_ALLOW_HTTP_LOOPBACK=false
# Optional: permit anonymous requests only in Vite DEV against a Java dev profile.
# This grants NO browser roles and never bypasses server authorization.
VITE_ALLOW_ANONYMOUS_DEV=false
