# Copy to .local/compose-app/provider.env when you have a provider key.
# The same private file works for Compose and infra/local/run.py.
# Keep all three blank until ready; do not commit the real values.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Optional per-model request deadline (100..120000ms); Java also has a total budget.
LLM_TIMEOUT_MS=30000
# Ollama on the same host as Python: http://127.0.0.1:11434/v1
# Docker Desktop Python -> host Ollama: http://host.docker.internal:11434/v1
# Set LLM_MODEL to an installed model and LLM_API_KEY=ollama for local Ollama only.
# See docs/llm-provider.md; this file does not download or train any model.
