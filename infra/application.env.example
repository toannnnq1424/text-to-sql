# Public deployment settings only. Secrets are generated under .local/compose-app/.
NLA_COMPOSE_WEB_PORT=4173
NLA_COMPOSE_API_PORT=8085
OIDC_ISSUER_URI=http://127.0.0.1:8180/realms/nla
# Java validates the public issuer while fetching keys over the container network.
OIDC_JWK_SET_URI=http://keycloak:8080/realms/nla/protocol/openid-connect/certs
